generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WishlistStatus {
  OPEN
  RESERVED
  ORDERED
  FULFILLED
}

enum Locale {
  EN
  RU
  KK
}

enum WishVisibility {
  PUBLIC
  FRIENDS
  CUSTOM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id                Int            @id @default(autoincrement())
  telegramId        BigInt         @unique
  username          String?
  login             String?        @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  preferredLocale   Locale         @default(EN)
  defaultVisibility WishVisibility @default(PUBLIC)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  wishes            Wishlist[]     @relation("UserWishes")
  ordered           Wishlist[]     @relation("UserOrderedWishes")
  subscriptions     Subscription[] @relation("SubscriptionsOut")
  subscribers       Subscription[] @relation("SubscriptionsIn")
  friendRequestsOut Friendship[]   @relation("FriendshipOut")
  friendRequestsIn  Friendship[]   @relation("FriendshipIn")
  wishAccesses      WishAccess[]
}

model Subscription {
  id           Int      @id @default(autoincrement())
  subscriberId Int
  targetId     Int
  subscriber   User     @relation("SubscriptionsOut", fields: [subscriberId], references: [id], onDelete: Cascade)
  target       User     @relation("SubscriptionsIn", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([subscriberId, targetId])
  @@index([targetId])
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  requester   User             @relation("FriendshipOut", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipIn", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model WishAccess {
  wishId String
  userId Int
  wish   Wishlist @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([wishId, userId])
  @@index([userId])
}

model Wishlist {
  id            String         @id @default(uuid())
  name          String
  price         Decimal?       @db.Decimal(12, 2)
  url           String?        @db.Text
  description   String?        @db.Text
  ownerId       Int
  owner         User           @relation("UserWishes", fields: [ownerId], references: [id], onDelete: Cascade)

  orderedById   Int?
  orderedBy     User?          @relation("UserOrderedWishes", fields: [orderedById], references: [id], onDelete: SetNull)

  status        WishlistStatus @default(OPEN)
  visibility    WishVisibility @default(PUBLIC)
  accesses      WishAccess[]
  images        WishImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerId])
  @@index([orderedById])
  @@unique([ownerId, name, url])
}

// Фото желания. key — имя файла в хранилище (см. src/media); размеры после
// обработки нужны masonry-сетке, чтобы резервировать место до загрузки.
// position = 0 — обложка.
model WishImage {
  id       String   @id @default(uuid())
  wishId   String
  wish     Wishlist @relation(fields: [wishId], references: [id], onDelete: Cascade)
  key      String   @unique
  width    Int
  height   Int
  position Int

  @@index([wishId, position])
}
